# Every variable this service reads, whether or not it has a default.
#
# Four were documented here while fourteen more were live in the code, which is how a
# deployment comes up "working" with rate limiting at a default nobody chose and the API
# reference open because NODE_ENV was not what somebody assumed. Anything below without a
# default is required; anything with one states it, so leaving it blank is a decision
# rather than an accident.

# ----------------------------------------------------------------- required

# Mongo connection. Matches the existing site's cluster in production.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dns_pricing

# Signs the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ------------------------------------------------- inbound service callers

# Shared key the booking website presents as x-api-key on /api/*.
# Deprecated in favour of SERVICE_KEYS below, and kept because a live caller uses it.
# Generate with: openssl rand -base64 36
BOOKING_API_KEY=

# Keys accepted for signed (HMAC) requests, as comma-separated keyId:secret pairs.
# Each secret must be at least 32 characters or the key is ignored — a short secret fails
# at the door rather than quietly protecting nothing. A list, not one value, so a key can
# be rotated without downtime: publish the new one beside the old, move the caller across,
# then drop the old one.
#   SERVICE_KEYS=core:<secret>,core-next:<secret>
SERVICE_KEYS=

# Restricts a key to one customer, as comma-separated keyId:CUSTOMERCODE pairs.
#
# Authentication answers "is this a caller we know". It does not answer "may this caller
# see this customer", and a key not named here may act for every customer — correct for
# the SameX core and the admin console, which act for everybody, and wrong for a
# per-tenant caller such as one enterprise customer's portal. A key listed here is refused
# 403 on any other customer's rates, account, billing, team and quotes, and the customer
# list returns only its own row.
#
# Empty means no key is scoped, which is the behaviour every existing caller has today.
#   SERVICE_KEY_SCOPES=portal-acme:ACME,portal-mahle:MAHLE
SERVICE_KEY_SCOPES=

# Requests per minute per calling key. Default 600. A zero or negative value is ignored
# rather than obeyed, since refusing everything is never what setting a limit meant.
API_RATE_LIMIT=

# Whether /api/docs serves the published contract: "on", "off", or unset.
# Unset means open outside production and closed in it. Every route here prices freight,
# so the route list is a target list — in production this stays closed unless somebody
# deliberately opens it.
API_DOCS=

# ------------------------------------------------ outbound calls to the core

# Where this service calls the SameX core, and the key it signs those calls with.
# All three must be set for outbound calls to be attempted; with any of them missing the
# integration is treated as not configured rather than failing per request.
CORE_API_URL=
CORE_SERVICE_KEY_ID=
CORE_SERVICE_SECRET=

# --------------------------------------------------------------- behaviour

# Which rate card an anonymous quote prices against — a commercial decision, not a
# property of the code. Default model-1.
PRICING_DEFAULT_CARD_KEY=

# Prefix on generated invoice numbers. Default DNS.
INVOICE_SERIES_PREFIX=

# ------------------------------------------------------- build and tooling
#
# Set by the platform or by scripts, not usually by hand.
#
#   PORT              Port the server listens on. Default 3000.
#   NODE_ENV          Set by Next. Decides the API_DOCS default above.
#   BUILD_COMMIT      Stamped by scripts/deploy.ts; reported by /api/health so a
#                     deployment can be checked against the commit that was pushed.
#   NEXT_BUILD_ID     Passed by scripts/standalone.mjs so a running server reports the
#                     build it is actually serving rather than what is on disk.
#   SKIP_BUILD=1      Skip the rebuild in scripts/standalone.mjs.
#   DEPLOY_HEALTH_URL Health endpoint scripts/deploy.ts polls after uploading.
#   E2E_BASE_URL      Base URL the Playwright suite runs against. Default localhost:3000.
#   CI                Set by the CI runner; makes Playwright retry and run headless.
#   RAILWAY_SERVICE   Set by the platform; names the service in deploy output.
