# Mongo connection. Matches the existing site's cluster in production.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dns_pricing

# Signs the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Shared key the booking website presents as x-api-key on /api/*
# Generate with: openssl rand -base64 36
BOOKING_API_KEY=
